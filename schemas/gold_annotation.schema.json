{
  "$defs": {
    "AnnotationMetadata": {
      "additionalProperties": false,
      "properties": {
        "annotation_mode": {
          "enum": [
            "independent",
            "adjudicated"
          ],
          "title": "Annotation Mode",
          "type": "string"
        },
        "annotator_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,63}$",
          "title": "Annotator Id",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "human_verified": {
          "default": false,
          "title": "Human Verified",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "source_annotation_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Source Annotation Ids",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "annotator_id",
        "annotation_mode",
        "started_at"
      ],
      "title": "AnnotationMetadata",
      "type": "object"
    },
    "AttackTechnique": {
      "additionalProperties": false,
      "properties": {
        "candidate_technique_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Candidate Technique Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "mapping_reason": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Mapping Reason",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 2,
          "title": "Name",
          "type": "string"
        },
        "step_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Step Ids",
          "type": "array"
        },
        "technique_id": {
          "pattern": "^T[0-9]{4}(?:\\.[0-9]{3})?$",
          "title": "Technique Id",
          "type": "string"
        }
      },
      "required": [
        "technique_id",
        "name",
        "step_ids",
        "evidence_ids",
        "mapping_reason",
        "confidence"
      ],
      "title": "AttackTechnique",
      "type": "object"
    },
    "AutomationProvenance": {
      "additionalProperties": false,
      "properties": {
        "automatically_selected_gold": {
          "const": false,
          "default": false,
          "title": "Automatically Selected Gold",
          "type": "boolean"
        },
        "candidates_only": {
          "const": true,
          "default": true,
          "title": "Candidates Only",
          "type": "boolean"
        },
        "human_selection_required": {
          "const": true,
          "default": true,
          "title": "Human Selection Required",
          "type": "boolean"
        }
      },
      "title": "AutomationProvenance",
      "type": "object"
    },
    "EvidenceGap": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Description",
          "type": "string"
        },
        "gap_id": {
          "pattern": "^gap_[0-9]{2,3}$",
          "title": "Gap Id",
          "type": "string"
        },
        "impact": {
          "enum": [
            "root_cause",
            "step",
            "edge",
            "technique",
            "other"
          ],
          "title": "Impact",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "description",
        "impact"
      ],
      "title": "EvidenceGap",
      "type": "object"
    },
    "IncidentStep": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "end_ts_ns": {
          "minimum": 0,
          "title": "End Ts Ns",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "start_ts_ns": {
          "minimum": 0,
          "title": "Start Ts Ns",
          "type": "integer"
        },
        "step_id": {
          "pattern": "^step_[0-9]{2,3}$",
          "title": "Step Id",
          "type": "string"
        },
        "step_type": {
          "enum": [
            "external_connection",
            "socket_accept",
            "request_read",
            "process_spawn",
            "execution",
            "file_read",
            "file_write",
            "outbound_connection",
            "discovery",
            "privilege_change",
            "persistence",
            "other_observed"
          ],
          "title": "Step Type",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "step_type",
        "summary",
        "start_ts_ns",
        "end_ts_ns",
        "evidence_ids",
        "confidence"
      ],
      "title": "IncidentStep",
      "type": "object"
    },
    "PossiblyCausalEdge": {
      "additionalProperties": false,
      "properties": {
        "basis_evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Basis Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Rationale",
          "type": "string"
        },
        "relation_type": {
          "const": "possibly_causes",
          "default": "possibly_causes",
          "title": "Relation Type",
          "type": "string"
        },
        "source_evidence_id": {
          "title": "Source Evidence Id",
          "type": "string"
        },
        "target_evidence_id": {
          "title": "Target Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "source_evidence_id",
        "target_evidence_id",
        "basis_evidence_ids",
        "rationale",
        "confidence"
      ],
      "title": "PossiblyCausalEdge",
      "type": "object"
    },
    "ProvenanceEdge": {
      "additionalProperties": false,
      "properties": {
        "basis_evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Basis Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Rationale",
          "type": "string"
        },
        "relation_type": {
          "enum": [
            "provenance",
            "precedes",
            "correlates_with"
          ],
          "title": "Relation Type",
          "type": "string"
        },
        "source_evidence_id": {
          "title": "Source Evidence Id",
          "type": "string"
        },
        "target_evidence_id": {
          "title": "Target Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "source_evidence_id",
        "target_evidence_id",
        "relation_type",
        "basis_evidence_ids",
        "rationale",
        "confidence"
      ],
      "title": "ProvenanceEdge",
      "type": "object"
    },
    "RootCauseEntity": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "entity_id": {
          "pattern": "^ent_[0-9a-f]{24}$",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "enum": [
            "connection",
            "socket",
            "process",
            "thread",
            "file",
            "other"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "rationale",
        "evidence_ids",
        "confidence"
      ],
      "title": "RootCauseEntity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_split": {
      "enum": [
        "development",
        "test"
      ],
      "title": "Agent Split",
      "type": "string"
    },
    "anchor_times_ns": {
      "items": {
        "type": "integer"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Anchor Times Ns",
      "type": "array"
    },
    "annotation_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annotation Confidence"
    },
    "annotation_id": {
      "pattern": "^ann:INC-[0-9]{3}:[A-Za-z0-9_.-]+$",
      "title": "Annotation Id",
      "type": "string"
    },
    "attack_techniques": {
      "items": {
        "$ref": "#/$defs/AttackTechnique"
      },
      "maxItems": 100,
      "title": "Attack Techniques",
      "type": "array"
    },
    "automation_provenance": {
      "$ref": "#/$defs/AutomationProvenance"
    },
    "core_evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "title": "Core Evidence Ids",
      "type": "array"
    },
    "incident_id": {
      "pattern": "^INC-[0-9]{3}$",
      "title": "Incident Id",
      "type": "string"
    },
    "investigation_end_ts_ns": {
      "minimum": 0,
      "title": "Investigation End Ts Ns",
      "type": "integer"
    },
    "investigation_start_ts_ns": {
      "minimum": 0,
      "title": "Investigation Start Ts Ns",
      "type": "integer"
    },
    "known_evidence_gaps": {
      "items": {
        "$ref": "#/$defs/EvidenceGap"
      },
      "maxItems": 100,
      "title": "Known Evidence Gaps",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/AnnotationMetadata"
    },
    "possibly_causal_edges": {
      "items": {
        "$ref": "#/$defs/PossiblyCausalEdge"
      },
      "maxItems": 200,
      "title": "Possibly Causal Edges",
      "type": "array"
    },
    "private_family": {
      "maxLength": 200,
      "minLength": 3,
      "title": "Private Family",
      "type": "string"
    },
    "provenance_edges": {
      "items": {
        "$ref": "#/$defs/ProvenanceEdge"
      },
      "maxItems": 500,
      "title": "Provenance Edges",
      "type": "array"
    },
    "root_cause_ambiguous": {
      "default": false,
      "title": "Root Cause Ambiguous",
      "type": "boolean"
    },
    "root_cause_entities": {
      "items": {
        "$ref": "#/$defs/RootCauseEntity"
      },
      "maxItems": 50,
      "title": "Root Cause Entities",
      "type": "array"
    },
    "scenario_token": {
      "pattern": "^tw_[0-9a-f]{24}$",
      "title": "Scenario Token",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "draft",
        "completed"
      ],
      "title": "Status",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/IncidentStep"
      },
      "maxItems": 100,
      "title": "Steps",
      "type": "array"
    },
    "supporting_evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "title": "Supporting Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "status",
    "annotation_id",
    "incident_id",
    "private_family",
    "scenario_token",
    "agent_split",
    "investigation_start_ts_ns",
    "investigation_end_ts_ns",
    "anchor_times_ns",
    "metadata"
  ],
  "title": "GoldAnnotation",
  "type": "object"
}
